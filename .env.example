# ============================================
# FacePay Stream Analyzer — Configuration
# ============================================
# Скопируйте этот файл в .env и измените значения
# cp .env.example .env
#
# ВНИМАНИЕ: Никогда не коммитьте .env в Git!
# Файл уже добавлен в .gitignore

# --------------------------------------------
# PostgreSQL
# --------------------------------------------
POSTGRES_DB=facepay_stream
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_password

# --------------------------------------------
# Kafka
# --------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=face-pay-logs

# --------------------------------------------
# Spark Consumer
# --------------------------------------------
POSTGRES_URL=jdbc:postgresql://postgres:5432/facepay_stream
POSTGRES_TABLE=critical_logs

# --------------------------------------------
# API Server
# --------------------------------------------
SERVER_PORT=8080
